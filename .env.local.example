# ToGo Web Catalog - Environment Variables
# Copy this file to .env.local and fill in your values

# ═══════════════════════════════════════════════════════════
# App Configuration
# ═══════════════════════════════════════════════════════════

# Public URL of this web app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ═══════════════════════════════════════════════════════════
# API Configuration
# ═══════════════════════════════════════════════════════════

# Base URL of the ToGo API (NestJS backend)
# IMPORTANT: Include the API version (/v1/) at the end
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Note: The API runs on port 3000 by default
# This web app runs on port 3001 by default

# ═══════════════════════════════════════════════════════════
# Revalidation (ISR)
# ═══════════════════════════════════════════════════════════

# Secret for POST /api/revalidate — MUST match REVALIDATE_SECRET in the API (api-togo)
# If unset, the revalidate endpoint responds 503 (disabled)
REVALIDATE_SECRET=your-secret-key-here
